<%# Los cuestionarios validados que un tipo de formulario trae ADENTRO de la preconsulta (D140):
    la batería del formulario de Migue en la preconsulta vestibular. Las definiciones salen de
    src/config/cuestionarios.js — las mismas que sirve /cuestionario/:token —, y el servidor
    las valida con extraerCuestionarios().

    Recibe `cuestionarios` (definiciones, con su `key`) y `esCarga` (carga manual: nada es
    obligatorio, pero un cuestionario empezado tiene que terminarse — lo dice el servidor).

    Botones y no sliders, igual que las escalas de los bloques: un slider arranca en algún número
    y lo manda aunque el paciente nunca lo haya tocado. Un botón sin tocar no manda nada, y el
    instrumento queda incompleto en vez de contestado con un valor inventado. %>
<% if ((cuestionarios || []).length) { %>
  <div class="form-section">
    <div class="section-header"><%= t('pre.cuestionariosTitulo') %></div>
    <p class="small text-muted mb-0"><%= t('pre.cuestionariosIntro', { n: cuestionarios.length }) %></p>
  </div>
<% } %>
<% (cuestionarios || []).forEach((def) => { %>
  <div class="form-section" data-cuestionario="<%= def.key %>">
    <div class="section-header"><%= def.tituloPublico %></div>
    <p class="small text-muted"><%= def.subtituloPublico %></p>

    <% def.items.forEach((item, i) => {
         const nombre = 'cq:' + def.key + ':' + item.key;
         const idBase = 'cq_' + def.key + '_' + item.key;
         const req = (!item.opcional && !esCarga) ? 'required' : '';
    %>
      <% if (item.antes) { %><p class="fw-semibold mt-3 mb-2"><%= item.antes %></p><% } %>
      <div class="mb-3 pb-2 <%= i < def.items.length - 1 ? 'border-bottom' : '' %>">
        <div class="form-label" id="<%= idBase %>_rotulo">
          <span class="text-muted small me-1"><%= i + 1 %>.</span><%= item.texto %>
          <% if (item.opcional) { %><span class="badge-opt"><%= t('pre.opcional') %></span><% } %>
        </div>

        <% if (item.tipo === 'numerica') { %>
          <% const _min = item.min ?? 0, _max = item.max ?? 10; %>
          <div class="d-flex flex-wrap gap-1" role="radiogroup" aria-labelledby="<%= idBase %>_rotulo">
            <% for (let n = _min; n <= _max; n++) { %>
              <input type="radio" class="btn-check" name="<%= nombre %>" id="<%= idBase %>_<%= n %>" value="<%= n %>" autocomplete="off" <%- req %>>
              <label class="btn btn-outline-primary btn-sm bq-escala-num" for="<%= idBase %>_<%= n %>"><%= n %></label>
            <% } %>
          </div>
          <div class="d-flex justify-content-between small text-muted mt-1">
            <span><%= _min %> · <%= item.anclaBaja %></span>
            <span><%= item.anclaAlta %> · <%= _max %></span>
          </div>
        <% } else { %>
          <div class="d-flex flex-wrap gap-2" role="radiogroup" aria-labelledby="<%= idBase %>_rotulo">
            <% item.opciones.forEach((o) => { %>
              <input type="radio" class="btn-check" name="<%= nombre %>" id="<%= idBase %>_<%= o.valor %>" value="<%= o.valor %>" autocomplete="off" <%- req %>>
              <label class="btn btn-outline-primary btn-sm" for="<%= idBase %>_<%= o.valor %>"><%= o.label %></label>
            <% }) %>
          </div>
        <% } %>

        <%# Un aviso al paciente que depende de lo que contesta (la pregunta 9 del PHQ-9, D138). Hoy
            ninguno de los cuestionarios embebidos lo tiene, pero si mañana entra uno que sí, el
            aviso tiene que aparecer igual que en /cuestionario/:token. Lo maneja public/bloques.js. %>
        <% if (item.avisoSi) { %>
          <div class="alert alert-warning small mt-2 mb-0 d-none" role="alert" data-aviso-campo="<%= nombre %>" data-aviso-mayor="<%= item.avisoSi.mayorQue %>"><%= item.aviso %></div>
        <% } %>
      </div>
    <% }) %>
  </div>
<% }) %>
