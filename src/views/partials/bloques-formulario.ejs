<%# Los bloques variables del formulario del paciente (D136). Las definiciones salen de
    src/config/bloques.js; esta vista no sabe qué pregunta es cada una, solo cómo se dibuja cada TIPO.

    Recibe `bloques` (definiciones), `esCarga` (la carga manual de Felipe: nada es obligatorio) y
    `lugar` (D140): dibuja solo los bloques de ese lugar del formulario — "identidad", "cuerpo"
    (el default) o "cierre". La preconsulta incluye este partial una vez por lugar.

    `data-mostrar-si` lleva la condición en JSON. public/bloques.js la evalúa con la misma función
    que usa el servidor para validar, y deshabilita lo que oculta. Lo que empieza visible y después
    se oculta es a propósito: sin JavaScript el formulario sigue mostrando todo y el servidor
    descarta lo que no correspondía.

    Los `value` de las opciones son las KEYS del catálogo, no el texto: el texto se traduce, la key
    es lo que se guarda (D127). %>
<% const _lugar = (typeof lugar !== 'undefined' && lugar) || 'cuerpo'; %>
<% (bloques || []).filter((b) => (b.lugar || 'cuerpo') === _lugar).forEach((b) => { %>
  <%# D146 — un bloque `integrado` se dibuja adentro de la sección que lo incluye, sin abrir una
      propia ni poner título (los datos sociodemográficos, dentro de "Datos personales"). %>
  <div class="<%= b.integrado ? '' : 'form-section' %>" data-bloque="<%= b.key %>" data-mostrar-si="<%= JSON.stringify(b.mostrarSi || null) %>">
    <% if (!b.integrado) { %><div class="section-header"><%= b.titulo %></div><% } %>
    <% if (b.intro) { %><p class="small text-muted"><%= b.intro %></p><% } %>

    <% b.items.forEach((it) => {
         const nombre = 'bq:' + b.key + ':' + it.key;
         const idBase = 'bq_' + b.key + '_' + it.key;
         const obligatoria = Boolean(it.requerido) && !esCarga;
         const req = obligatoria ? 'required' : '';
    %>
      <div class="mb-3" data-mostrar-si="<%= JSON.stringify(it.mostrarSi || null) %>">
        <%# D141 — el subtítulo va ADENTRO de la pregunta condicional: afuera quedaba siempre visible
            ("Sobre el dolor de espalda baja:" a quien le duele la rodilla). %>
        <% if (it.antes) { %><p class="fw-semibold mt-3 mb-2"><%= it.antes %></p><% } %>
        <% if (it.tipo === 'texto' || it.tipo === 'numero') { %>
          <label class="form-label" for="<%= idBase %>"><%= it.texto %>
        <% } else { %>
          <div class="form-label" id="<%= idBase %>_rotulo"><%= it.texto %>
        <% } %>
          <span class="<%= obligatoria ? 'badge-req' : 'badge-opt' %>"><%= obligatoria ? t('pre.obligatorio') : t('pre.opcional') %></span>
        <%- (it.tipo === 'texto' || it.tipo === 'numero') ? '</label>' : '</div>' %>

        <% if (it.tipo === 'opcion') { %>
          <div class="d-flex flex-wrap gap-2" role="radiogroup" aria-labelledby="<%= idBase %>_rotulo">
            <% it.opciones.forEach((o) => { %>
              <input type="radio" class="btn-check" name="<%= nombre %>" id="<%= idBase %>_<%= o.valor %>" value="<%= o.valor %>" autocomplete="off" <%- req %>>
              <label class="btn btn-outline-primary btn-sm" for="<%= idBase %>_<%= o.valor %>"><%= o.label %></label>
            <% }) %>
          </div>

        <% } else if (it.tipo === 'casillas') { %>
          <%# Sin `required`: el HTML no sabe exigir "al menos una casilla". Lo exige el servidor.
              `data-exclusiva` (D140): la opción que excluye a las demás ("Ninguno"). Marcarla
              desmarca y bloquea el resto — ver public/bloques.js. %>
          <div class="d-flex flex-wrap gap-2" role="group" aria-labelledby="<%= idBase %>_rotulo"<% if (it.exclusiva) { %> data-exclusiva="<%= it.exclusiva %>"<% } %>>
            <% it.opciones.forEach((o) => { %>
              <input type="checkbox" class="btn-check" name="<%= nombre %>" id="<%= idBase %>_<%= o.valor %>" value="<%= o.valor %>" autocomplete="off">
              <label class="btn btn-outline-secondary btn-sm" for="<%= idBase %>_<%= o.valor %>"><%= o.label %></label>
            <% }) %>
          </div>

        <% } else if (it.tipo === 'escala') { %>
          <%# Botones y no slider: un slider arranca en algún número, y ese número se manda aunque
              el paciente nunca lo haya tocado. Un botón sin tocar no manda nada. %>
          <div class="d-flex flex-wrap gap-1" role="radiogroup" aria-labelledby="<%= idBase %>_rotulo">
            <% for (let n = it.min; n <= it.max; n++) { %>
              <input type="radio" class="btn-check" name="<%= nombre %>" id="<%= idBase %>_<%= n %>" value="<%= n %>" autocomplete="off" <%- req %>>
              <label class="btn btn-outline-primary btn-sm bq-escala-num" for="<%= idBase %>_<%= n %>"><%= n %></label>
            <% } %>
          </div>
          <div class="d-flex justify-content-between small text-muted mt-1">
            <span><%= it.min %> · <%= it.anclaBaja %></span>
            <span><%= it.anclaAlta %> · <%= it.max %></span>
          </div>

        <% } else if (it.tipo === 'deslizador') { %>
          <%# D141 — un deslizador con las opciones como marcas. Resuelve la trampa de arriba así:
              el `range` NO tiene name, y lo que se manda es el hidden, que arranca VACÍO y recién
              se llena cuando el paciente lo mueve (public/index.js). Hasta entonces el deslizador
              se ve apagado y dice "sin responder". Un hidden no lo valida el navegador: por eso
              lleva `data-requerido`, y lo controla el envío (además del servidor, como siempre). %>
          <%# D154 — `porDefecto` (el painDETECT arranca en "Nunca"): el hidden ya trae el valor y el
              deslizador se dibuja tocado, en esa posición. %>
          <% const _def = it.porDefecto != null ? it.opciones.findIndex((o) => o.valor === it.porDefecto) : -1; %>
          <div class="bq-deslizador" data-deslizador>
            <input type="hidden" name="<%= nombre %>" value="<%= _def >= 0 ? it.porDefecto : '' %>" data-por-defecto="<%= _def >= 0 ? it.porDefecto : '' %>" <%- obligatoria ? 'data-requerido="1"' : '' %> data-pregunta="<%= it.texto %>">
            <input type="range" class="dolor-slider <%= _def >= 0 ? '' : 'bq-sin-tocar' %>" min="0" max="<%= it.opciones.length - 1 %>" step="1" value="<%= _def >= 0 ? _def : 0 %>"
                   aria-labelledby="<%= idBase %>_rotulo" data-valores="<%= JSON.stringify(it.opciones.map((o) => o.valor)) %>">
            <div class="d-flex justify-content-between small text-muted bq-deslizador-marcas">
              <% it.opciones.forEach((o) => { %><span><%= o.label %></span><% }) %>
            </div>
            <div class="small fw-semibold mt-1" data-deslizador-valor data-sin-responder="<%= t('pre.sinResponder') %>"><%= _def >= 0 ? it.opciones[_def].label : t('pre.sinResponder') %></div>
          </div>

        <% } else if (it.tipo === 'numero') { %>
          <input type="number" class="form-control" style="max-width:10rem" name="<%= nombre %>" id="<%= idBase %>"
                 min="<%= it.min %>" max="<%= it.max %>" step="1" inputmode="numeric" <%- req %>>

        <% } else if (it.tipo === 'texto') { %>
          <input type="text" class="form-control" name="<%= nombre %>" id="<%= idBase %>" maxlength="300" <%- req %>>

        <% } else if (it.tipo === 'trayectoria') { %>
          <div class="row g-2" role="radiogroup" aria-labelledby="<%= idBase %>_rotulo">
            <% it.opciones.forEach((o) => { %>
              <div class="col-6 col-md-3">
                <input type="radio" class="btn-check" name="<%= nombre %>" id="<%= idBase %>_<%= o.valor %>" value="<%= o.valor %>" autocomplete="off" <%- req %>>
                <label class="btn btn-outline-primary w-100 h-100 bq-trayectoria" for="<%= idBase %>_<%= o.valor %>">
                  <svg viewBox="0 0 120 44" aria-hidden="true" focusable="false">
                    <line x1="0" y1="40" x2="120" y2="40" class="bq-eje"></line>
                    <path d="<%= o.trazo %>"></path>
                  </svg>
                  <span class="small d-block"><%= o.label %></span>
                </label>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>
<% }) %>
